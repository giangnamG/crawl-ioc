# syntax=docker/dockerfile:1

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    HOME=/home/appuser \
    APP_ENV=production \
    FLASK_ENV=production \
    FLASK_DEBUG=0 \
    DB_BACKEND=postgresql \
    AUTO_WORKER_ENABLED=true \
    CLOAK_HEADLESS=1 \
    BROWSER_PROVIDER=cloak \
    CLOAKBROWSER_CACHE_DIR=/home/appuser/.cloakbrowser \
    CLOAK_PROFILE_ROOT=/data/cloak_profiles \
    WORKER_POLL_SECONDS=3 \
    SEARCH_FAST_MODE=true \
    SEARCH_TYPE_DELAY_MIN=2 \
    SEARCH_TYPE_DELAY_MAX=5 \
    SEARCH_PAGE_DELAY_MIN=0 \
    SEARCH_PAGE_DELAY_MAX=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl wget gnupg \
        libnss3 libnspr4 libglib2.0-0 libdbus-1-3 \
        libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 libcups2 \
        libx11-xcb1 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
        libxext6 libxrender1 libxss1 libxtst6 libxkbcommon0 \
        libasound2 libgbm1 libgtk-3-0 libpango-1.0-0 libcairo2 \
        fonts-liberation tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /data /home/appuser/.cloakbrowser \
    && chown -R appuser:appuser /data /app /home/appuser

USER appuser

RUN python -m cloakbrowser install \
    && python -m cloakbrowser info

USER root

COPY --chown=appuser:appuser app.py /app/
COPY --chown=appuser:appuser ioc_app /app/ioc_app

USER appuser

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
